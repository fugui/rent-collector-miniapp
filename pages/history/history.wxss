/* pages/history/history.wxss */
.stats-card {
  background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
  color: #ffffff;
  padding: 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(30, 27, 75, 0.3);
}

.stats-header {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  padding-bottom: 16rpx;
  margin-bottom: 24rpx;
}

.stats-header .title {
  font-size: 30rpx;
  font-weight: 700;
}

.count-badge {
  background: rgba(255, 255, 255, 0.15);
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-item .label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.stat-item .val {
  font-size: 32rpx;
  font-weight: 700;
}

.stat-item .val.primary {
  color: #818cf8;
  font-size: 36rpx;
  font-weight: 800;
}

.btn-export {
  font-size: 26rpx;
  padding: 18rpx 0;
  border-radius: 36rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin: 30rpx 0 16rpx 8rpx;
}

.empty-tip {
  text-align: center;
  color: #94a3b8;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.history-card {
  transition: transform 0.2s ease;
}

.history-card:active {
  transform: scale(0.99);
}

.history-header {
  border-bottom: 1rpx solid #f1f5f9;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
}

.month-tag {
  display: flex;
  align-items: center;
}

.month-tag .icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.month-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.arrow-icon {
  font-size: 24rpx;
  color: #4f46e5;
  font-weight: 600;
}

.rooms-preview {
  background: #f8fafc;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.room-preview-item {
  font-size: 26rpx;
}

.room-label {
  color: #64748b;
}

.room-price {
  font-weight: 700;
  color: #1e293b;
}

.history-footer {
  font-size: 22rpx;
  color: #94a3b8;
}

.tag-status {
  color: #16a34a;
  background: #dcfce7;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

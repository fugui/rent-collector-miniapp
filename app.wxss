/** app.wxss - 全局统一精致样式库 **/
page {
  background-color: #f8fafc;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: #1e293b;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 全局容器 */
.container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片风格 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #f1f5f9;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title .icon {
  margin-right: 12rpx;
}

/* 主主题按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
  font-weight: 600;
  font-size: 30rpx;
  border-radius: 44rpx;
  padding: 22rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.3);
  transition: all 0.2s ease;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.btn-secondary {
  background: #e0e7ff;
  color: #3730a3;
  font-weight: 600;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-outline {
  background: #ffffff;
  color: #4f46e5;
  border: 2rpx solid #818cf8;
  font-weight: 600;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 18rpx 0;
  text-align: center;
}

/* 徽章 / Tag */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-primary {
  background: #e0e7ff;
  color: #4338ca;
}

.badge-success {
  background: #dcfce7;
  color: #15803d;
}

.badge-warning {
  background: #fef3c7;
  color: #b45309;
}

/* 表单组合 */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #0f172a;
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: #6366f1;
}

/* 布局类 */
.flex-row {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-bold {
  font-weight: 700;
}

.text-muted {
  color: #64748b;
  font-size: 24rpx;
}
